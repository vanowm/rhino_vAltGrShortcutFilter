<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net7.0-windows;net10.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RhinoHostMajor Condition="'$(RhinoHostMajor)' == '' and '$(TargetFramework)' == 'net7.0-windows'">8</RhinoHostMajor>
    <RhinoHostMajor Condition="'$(RhinoHostMajor)' == '' and '$(TargetFramework)' == 'net10.0-windows'">9</RhinoHostMajor>
    <AssemblyName Condition="'$(RhinoHostMajor)' == '8' or ('$(RhinoHostMajor)' == '' and '$(TargetFramework)' == 'net7.0-windows')">vAltGrShortcutFilter.Rhino8</AssemblyName>
    <AssemblyName Condition="'$(RhinoHostMajor)' == '9' or ('$(RhinoHostMajor)' == '' and '$(TargetFramework)' == 'net10.0-windows')">vAltGrShortcutFilter.Rhino9</AssemblyName>
    <Product>vAltGr Shortcut Filter</Product>
    <Title>vAltGr Shortcut Filter</Title>
    <RootNamespace>vAltGrShortcutFilter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <BuildInParallel>false</BuildInParallel>
    <ReleaseDllPaths>bin/Release/Rhino8/net7.0-windows/vAltGrShortcutFilter.Rhino8.dll;bin/Release/Rhino9/net10.0-windows/vAltGrShortcutFilter.Rhino9.dll</ReleaseDllPaths>
    <Rhino9SystemDirectory Condition="Exists('$(ProgramFiles)\Rhino 9\System\RhinoCommon.dll')">$(ProgramFiles)\Rhino 9\System</Rhino9SystemDirectory>
    <Rhino9SystemDirectory Condition="'$(Rhino9SystemDirectory)' == '' and Exists('$(ProgramFiles)\Rhino 9 WIP\System\RhinoCommon.dll')">$(ProgramFiles)\Rhino 9 WIP\System</Rhino9SystemDirectory>
    <RhinoSystemDirectory Condition="'$(RhinoHostMajor)' == '8'">$(ProgramFiles)\Rhino 8\System</RhinoSystemDirectory>
    <RhinoSystemDirectory Condition="'$(RhinoHostMajor)' == '9'">$(Rhino9SystemDirectory)</RhinoSystemDirectory>


    <Rhino8RuntimeAssemblyName>vAltGrShortcutFilter.Rhino8</Rhino8RuntimeAssemblyName>
    <DefineConstants Condition="'$(RhinoHostMajor)' == '8'">$(DefineConstants);RHINO8</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != ''">
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDirectory)\RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rhino.UI">
      <HintPath>$(RhinoSystemDirectory)\Rhino.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateRhinoReferences" BeforeTargets="ResolveReferences" Condition="'$(TargetFramework)' != '' and !Exists('$(RhinoSystemDirectory)\RhinoCommon.dll')">
    <Error Text="$(TargetFramework) requires its matching Rhino installation; RhinoCommon.dll was not found under '$(RhinoSystemDirectory)'." />
  </Target>

  <Import Project="Host.Build.targets" />
  <Import Project="Build.Release.targets" />
</Project>
